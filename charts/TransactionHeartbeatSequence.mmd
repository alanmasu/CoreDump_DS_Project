---
title: HeartbeatTransaction message exchange
config:
    theme: forest
---

sequenceDiagram

    %% HeartbeatTransaction is a normal Java object owned by Replica, not an
    %% Akka actor with its own mailbox. For that reason, the diagram shows the
    %% Replica actors as participants and describes transaction states in notes.

    %% S is the ActorSystem scheduler. C is the current coordinator actor.
    %% N represents the latency-aware FIFO NetworkChannel between C and one
    %% representative follower F. A real broadcast uses one channel per target.
    participant S as Akka Scheduler
    participant C as Coordinator Replica
    participant N as Network Channel
    participant F as Follower Replica

    %% Master and InitSystem are intentionally outside this diagram's scope.
    %% Heartbeat timers start only after each Replica has processed InitSystem
    %% and knows both the group membership and current coordinator ID.
    Note over C,F: All replicas have processed InitSystem

    %% These notes connect the message exchange to TransactionHeartbeatFSM.mmd.
    %% One HeartbeatTransaction is active per Replica for one coordinator term.
    Note over C: HeartbeatTransaction state = COORDINATOR
    Note over F: HeartbeatTransaction state = WATCHING

    %% The two startup operations are independent, so their execution order is
    %% not important. scheduleOnce is an Akka Scheduler API call, not a network
    %% protocol message. "self" means the scheduling Replica's own ActorRef.
    %% The full Java call will also supply a dispatcher and sender ActorRef.
    par Coordinator timer startup
        C ->> S: scheduleOnce(heartbeatInterval, self, HeartbeatTick)
    and Follower watchdog startup
        %% watchdogVersion is local to F and starts at 0. Every newly armed
        %% watchdog increments it before placing that value in WatchdogExpired.
        %% The value never travels through NetworkChannel or to another Replica.
        F ->> F: watchdogVersion = watchdogVersion + 1
        F ->> S: scheduleOnce(watchdogTimeout, self, WatchdogExpired(watchdogVersion))
    end

    %% Akka is not a real-time system, so startup call order alone cannot ensure
    %% that HEARTBEAT arrives before WatchdogExpired. The watchdog duration must
    %% leave room for the heartbeat interval, channel latency, and scheduling
    %% tolerance. The exact timeout formula will be defined in one Java helper.
    Note over S,F: watchdogTimeout is longer than the heartbeat interval + delivery tolerance

    %% We use recursive one-shot scheduling rather than a repeating fixed-rate
    %% task: handling one HeartbeatTick sends HEARTBEAT and schedules the next
    %% HeartbeatTick. This makes timer ownership and cancellation explicit.
    loop While the coordinator is healthy
        %% -->> represents delayed/asynchronous delivery into C's actor mailbox.
        %% HeartbeatTick is internal; it is never broadcast to followers.
        S -->> C: HeartbeatTick
        Note right of C: FSM stays in COORDINATOR

        %% HEARTBEAT is the actual network message. C sends it through the
        %% inherited network-emulation path, represented here by N.
        C ->> N: HEARTBEAT
        C ->> S: scheduleOnce(heartbeatInterval, self, HeartbeatTick)

        %% N adds simulated latency and preserves FIFO ordering for this
        %% sender-destination pair before delivering HEARTBEAT to F's mailbox.
        Note over N: Delayed FIFO delivery
        N -->> F: HEARTBEAT

        %% A valid HEARTBEAT keeps F in WATCHING and resets its watchdog.
        %% cancel(currentWatchdog) is diagram shorthand for calling cancel() on
        %% the Cancellable stored by the transaction; it is not an Akka message.
        %% Incrementing watchdogVersion makes any older WatchdogExpired message
        %% distinguishable if cancellation happened after it entered the mailbox.
        Note right of F: FSM stays in WATCHING
            F ->> S: cancel(currentWatchdog)
            F ->> F: watchdogVersion = watchdogVersion + 1
            F ->> S: scheduleOnce(watchdogTimeout, self, WatchdogExpired(watchdogVersion))
    end


    %% The healthy loop ends when the coordinator crashes. No HEARTBEAT arrow
    %% is drawn here because a crashed coordinator sends nothing.
    Note over C,F: Coordinator crashes and sends no more HEARTBEAT messages

    %% The crashed coordinator cannot cancel its timer or perform another state
    %% transition. A HeartbeatTick that was scheduled before the crash may still
    %% be sent, but the crashed Replica ignores it and broadcasts no HEARTBEAT.
    Note right of C: Replica is crashed, HeartbeatTransaction no longer runs
    S --x C: pending HeartbeatTick is ignored

    %% Since no valid HEARTBEAT resets the follower's watchdog, Akka
    %% eventually delivers the WatchdogExpired object created by scheduleOnce().
    S -->> F: WatchdogExpired(watchdogVersion)
    F ->> F: Compare messageVersion with current watchdogVersion

    %% The version check distinguishes the active watchdog from a cancelled
    %% watchdog message that reached the mailbox too late to be removed.
    alt Current version and FSM is WATCHING
        %% Changing state first prevents later timeout messages from starting
        %% additional elections.
        Note right of F: FSM moves from WATCHING to ELECTION_REQUESTED

        %% ElectionTransaction is a normal Java object owned by the same Replica,
        %% so this self-arrow represents an internal constructor/start call.
        F ->> F: Create and start ElectionTransaction

        %% The heartbeat transaction belonged to the failed coordinator term.
        %% ElectionTransaction now owns the recovery process, so this instance ends.
        Note right of F: HeartbeatTransaction ends
    else Stale version or election already requested
        %% Either the watchdog was reset by a newer HEARTBEAT, or another valid
        %% timeout has already started an election. No action should be repeated.
        Note right of F: Ignore WatchdogExpired
    end
